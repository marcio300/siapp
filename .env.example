# =====================================================================
# SIAPP — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Test/sandbox keys are fine to start.
# =====================================================================

# --- App ---
APP_URL="http://localhost:3000"

# --- Database (Postgres on Neon, eu-central-1) ---
# `pnpm dev:local` boots an embedded Postgres on port 5433 and writes this
# value for you on first run; point it at a Neon branch to use a real DB.
DATABASE_URL="postgresql://postgres:password@localhost:5433/siapp"

# Test database for `pnpm test` (see README "Testing"). Leave empty to let
# Vitest boot its own embedded Postgres on port 5434; set it to a dedicated
# Neon branch URL to run the suite against Neon. The suite TRUNCATES tables —
# never point it at a database you care about.
TEST_DATABASE_URL=""

# --- Auth (NextAuth, email magic link only) ---
AUTH_SECRET=""              # generate: openssl rand -base64 32

# --- Transactional email (Resend) ---
# Without an API key, emails (incl. sign-in links) are printed to the console.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="SIAPP <hello@siapp.club>"

# --- Stripe ---
STRIPE_SECRET_KEY=""        # sk_test_… / sk_live_…
STRIPE_WEBHOOK_SECRET=""    # whsec_… (from `stripe listen` or the dashboard endpoint)

# --- Seed (pnpm db:seed) ---
SEED_ADMIN_EMAIL="admin@siapp.club"   # the one ADMIN staff user; also gets a Member row so magic-link works
SEED_ADMIN_NAME="SIAPP Admin"
SEED_MEMBER_EMAIL=""                  # optional: a plain member to test the member sign-in with

# --- Cron (Phase 9) ---
CRON_SECRET=""
