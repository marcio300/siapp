// SIAPP — Prisma schema. Derived from docs/DATA_MODEL.md and docs/PRODUCT_SPEC.md.
// The NextAuth adapter tables (Account, Session, VerificationToken) hang off Member, ported from
// EventOS. Money is integer cents; all DateTime columns are UTC.

generator client {
  provider   = "prisma-client-js"
  // Engine-less client: queries compile in-process (WASM query compiler) and
  // run through the pg driver adapter (see src/lib/db.ts). Mirrors EventOS.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum TierCode {
  FREE
  SOCIAL
  REGULAR
  PLUS
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  TOURIST_WEEK
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum KeyPool {
  PLAN
  PURCHASED
}

enum KeyTransactionType {
  PLAN_GRANT
  PACK_PURCHASE
  REDEMPTION
  CANCELLATION_REFUND
  REFERRAL_BONUS
  EXPIRY
  ADMIN_ADJUSTMENT
  PROMO_GRANT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum OfferType {
  FREE_TICKET
  DISCOUNT_TICKET
  GUESTLIST
}

enum AllocationType {
  CAPPED
  TIME_WINDOW
}

enum AfterWindowBehaviour {
  REFUSE
  PAY_DOOR
}

enum RedemptionStatus {
  PENDING_PAYMENT
  HELD
  ACTIVE
  CANCELLED
  CHECKED_IN
  NO_SHOW
  EXPIRED
  DENIED
}

enum ScanResult {
  OK
  ALREADY_SCANNED
  WINDOW_CLOSED
  CANCELLED
  INVALID
}

/// Which door recorded a scan: our scanner, or the producer's EventOS scanner reporting in.
enum ScanSource {
  SIAPP
  EVENTOS
}

enum OutboundStatus {
  PENDING
  SENT
  FAILED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CLAIMED
  EXPIRED
}

enum ReferralStatus {
  PENDING
  VESTED
  REJECTED
}

enum FraudRule {
  DEVICE_MAX_ACCOUNTS
  VELOCITY_FIRST_HOUR
  VELOCITY_PRIVATE_SALE
  OVERLAP
  SAME_CARD
  SELF_REFERRAL
}

enum FraudFlagStatus {
  OPEN
  APPROVED
  DENIED
}

enum SettlementStatus {
  OPEN
  PAID
}

enum StaffRole {
  ADMIN
  OPS
  DOOR
}

/// Where an event is managed: by our staff (MANUAL) or by a producer's EventOS through the
/// partner API (EVENTOS — read-only in our backoffice, see docs/EVENTOS_INTEGRATION.md).
/// Pre-registration lead lifecycle (the /founders landing page, pre-launch lead capture).
enum FounderLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  UNSUBSCRIBED
}

enum EventSource {
  MANUAL
  EVENTOS
}

/// Who collects the cash of a DISCOUNT_TICKET offer. SIAPP_COLLECTS = Stripe Checkout here +
/// settlement to the producer; PRODUCER_COLLECTS = the member pays the producer through EventOS
/// checkout, nothing to settle (owner decision A, 2026-11-08).
enum PaymentMode {
  SIAPP_COLLECTS
  PRODUCER_COLLECTS
}

// ───────────────────────── Cities ─────────────────────────

model City {
  id        String   @id @default(cuid())
  name      String
  country   String // ISO 3166-1 alpha-2
  timezone  String // IANA, e.g. Europe/Lisbon
  currency  String // ISO 4217, e.g. EUR
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    Member[]
  producers  Producer[]
  events     Event[]
  planPrices PlanPrice[]
  founderLeads FounderLead[]

  @@unique([country, name])
}

// ───────────────────────── Members ─────────────────────────

// Member is also the NextAuth user (src/lib/auth.ts). `emailVerified` keeps the adapter's field
// name. `cityId` is null until onboarding (Phase 3) records the member's home city — the magic-link
// flow creates the row before any profile data exists.
model Member {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  dateOfBirth     DateTime?
  ageAttestedAt   DateTime? // explicit 24+ attestation at signup
  selfieUrl       String?
  selfieUploadedAt DateTime?
  idPhotoUrl      String? // tourists only; encrypted at rest, purged after 30 days
  idPhotoUploadedAt DateTime?
  cityId          String?
  referralCode    String    @unique
  onboardedAt     DateTime? // profile complete (name, DOB + 24+ attestation, city) — gates the member app
  partnerClaimToken   String? // partner (ELL) claim token entered at onboarding; verified + consumed in Phase 7
  partnerClaimTokenAt DateTime?
  bannedAt        DateTime?
  banReason       String?
  deletedAt       DateTime? // account deleted by the member: row anonymised, kept for the ledger/settlement records
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  city             City?             @relation(fields: [cityId], references: [id])
  accounts         Account[]
  sessions         Session[]
  subscriptions    Subscription[]
  keyTransactions  KeyTransaction[]
  keyBalance       KeyBalance?
  redemptions      Redemption[]
  waitlistEntries  WaitlistEntry[]
  referralsMade    Referral[]        @relation("Referrer")
  referralReceived Referral?         @relation("Invitee")
  partnerClaims    PartnerClaim[]
  devices          Device[]
  fraudFlags       FraudFlag[]
  attendanceStats  AttendanceStats?
  stripeCustomer   StripeCustomer?
  cardFingerprints PaymentMethodFingerprint[]
  notifications    NotificationLog[]
  founderLead      FounderLead?

  @@index([cityId])
}

// Pre-registration leads from the public /founders landing page (pre-launch lead capture through
// social-media ads). Not members: a lead gets an account only when we invite them. `number` is the
// founder number shown back to them ("you're founder #123"); `memberId` is linked when an account
// with the same email is created, so the founder deal can be honoured at checkout. Attribution is
// first touch only (the UTM fields are never overwritten on a repeat signup).
model FounderLead {
  id                 String            @id @default(cuid())
  number             Int               @unique @default(autoincrement())
  email              String            @unique
  name               String?
  cityId             String?
  status             FounderLeadStatus @default(NEW)
  consentAt          DateTime // ticked "contact me when SIAPP opens" (GDPR consent basis)
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  referrer           String?
  landingPath        String?
  unsubscribeToken   String            @unique @default(cuid())
  welcomeEmailSentAt DateTime?
  contactedAt        DateTime?
  contactedById      String?
  convertedAt        DateTime?
  memberId           String?           @unique
  unsubscribedAt     DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  city        City?      @relation(fields: [cityId], references: [id])
  member      Member?    @relation(fields: [memberId], references: [id])
  contactedBy StaffUser? @relation(fields: [contactedById], references: [id])

  @@index([status, createdAt])
  @@index([utmSource])
}

// One row per (member, kind, reference): the job-driven emails (reminders, expiry notices…) are
// sent at most once per reference, however often the cron runs or a webhook retries.
model NotificationLog {
  id        String    @id @default(cuid())
  memberId  String
  kind      String // welcome | plan_keys_granted | keys_expiring | event_reminder | no_show | payment_failed | tourist_expiring
  reference String
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, kind, reference])
  @@index([kind, createdAt])
}

// Stripe card fingerprints seen per member (from charge.succeeded) — the SAME_CARD fraud rule.
model PaymentMethodFingerprint {
  id          String   @id @default(cuid())
  memberId    String
  fingerprint String
  brand       String?
  last4       String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, fingerprint])
  @@index([fingerprint])
}

model StripeCustomer {
  memberId         String @id
  stripeCustomerId String @unique
  member           Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model AttendanceStats {
  memberId  String   @id
  shows     Int      @default(0)
  noShows   Int      @default(0)
  disputes  Int      @default(0)
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// ───────────────────────── NextAuth (Prisma adapter, attached to Member) ─────────────────────────
// The adapter reads the relation field `user` on Account/Session, so keep those names.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user Member @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user Member @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Tiers, plans, packs ─────────────────────────

model Tier {
  id                   String   @id @default(cuid())
  code                 TierCode @unique
  name                 String
  keysPerMonth         Int
  privateSaleByDefault Boolean  @default(false)
  plusOneByDefault     Boolean  @default(false)
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)

  plans Plan[]
}

model Plan {
  id              String        @id @default(cuid())
  tierId          String
  period          BillingPeriod
  name            String // shown in UI and used as the Stripe Product name
  keysPerPeriod   Int? // null = tier.keysPerMonth (granted monthly); TOURIST_WEEK sets its own amount
  stripeProductId String?
  isActive        Boolean       @default(true)

  tier          Tier           @relation(fields: [tierId], references: [id])
  prices        PlanPrice[]
  subscriptions Subscription[]

  @@unique([tierId, period])
}

model PlanPrice {
  id            String  @id @default(cuid())
  planId        String
  cityId        String
  currency      String
  amountCents   Int
  stripePriceId String? @unique

  plan Plan @relation(fields: [planId], references: [id])
  city City @relation(fields: [cityId], references: [id])

  @@unique([planId, cityId])
}

model KeyPack {
  id              String  @id @default(cuid())
  code            String  @unique // e.g. PACK_20 — stable handle for seeds and Stripe sync
  name            String
  keys            Int
  currency        String
  amountCents     Int
  stripeProductId String?
  stripePriceId   String? @unique
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)
}

// ───────────────────────── Subscriptions (mirror Stripe) ─────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  memberId             String
  planId               String
  stripeSubscriptionId String?            @unique // null for FREE, TOURIST_WEEK and partner promo periods
  checkoutSessionId    String?            @unique // Stripe Checkout Session that created it (one-off tourist pass idempotency)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  nextGrantAt          DateTime? // quarterly/yearly: next monthly key grant
  firstPaidAt          DateTime? // referral vesting clock
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  member Member @relation(fields: [memberId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([memberId, status])
  @@index([nextGrantAt])
  @@index([currentPeriodEnd])
}

// ───────────────────────── Keys ledger ─────────────────────────

model KeyTransaction {
  id           String             @id @default(cuid())
  memberId     String
  pool         KeyPool
  type         KeyTransactionType
  amount       Int // signed: grants +, spends/expiry −
  expiresAt    DateTime? // PLAN_GRANT rows: period end
  redemptionId String?
  reference    String? // idempotency handle for grants, e.g. "pack:cs_123" — unique per type
  note         String?
  createdById  String? // StaffUser for ADMIN_ADJUSTMENT
  createdAt    DateTime           @default(now())

  member     Member      @relation(fields: [memberId], references: [id])
  redemption Redemption? @relation(fields: [redemptionId], references: [id])
  createdBy  StaffUser?  @relation(fields: [createdById], references: [id])

  @@unique([type, reference])
  @@index([memberId, pool, createdAt])
  @@index([memberId, createdAt])
  @@index([redemptionId])
  @@index([expiresAt])
}

// Read cache only. Updated in the same transaction as every ledger write; the ledger is the truth.
model KeyBalance {
  memberId          String    @id
  planKeys          Int       @default(0)
  purchasedKeys     Int       @default(0)
  planKeysExpireAt  DateTime?
  updatedAt         DateTime  @updatedAt
  member            Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Supply side ─────────────────────────

model Producer {
  id                     String  @id @default(cuid())
  cityId                 String
  name                   String
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  payoutDetailsEncrypted String? // IBAN etc., encrypted at rest
  defaultDiscountPercent Int?
  usesEventOS            Boolean @default(false)
  notes                  String?
  // EventOS connection (partner API, docs/EVENTOS_INTEGRATION.md). The webhook secret is the
  // key SIAPP SIGNS WITH (outbound messages, photo URLs), so it is stored encrypted at rest, not
  // hashed; the previous secret stays valid for 24 h after a rotation.
  eventosOrgId                String?   @unique
  eventosOrgName              String?
  eventosAppUrl               String?
  eventosWebhookUrl           String?
  eventosWebhookSecretEnc     String?
  eventosPreviousSecretEnc    String?
  eventosPreviousSecretUntil  DateTime?
  eventosConnectedAt          DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  city        City         @relation(fields: [cityId], references: [id])
  events      Event[]
  settlements Settlement[]
  apiKeys     ProducerApiKey[]
  idempotency PartnerIdempotency[]
  outbound    OutboundEvent[]

  @@index([cityId])
}

/// Signed message to a producer's EventOS (contract docs/SIAPP_API.md §4): `id` is the envelope id
/// (ULID), the row is the outbox — PENDING until EventOS answers 2xx, retried with backoff, FAILED
/// after a final 4xx or the last attempt. `dedupeKey` coalesces `sales.updated` to one row per event.
model OutboundEvent {
  id             String         @id
  producerId     String
  eventId        String?
  type           String
  payload        Json
  dedupeKey      String?        @unique
  status         OutboundStatus @default(PENDING)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @default(now())
  lastError      String?
  responseStatus Int?
  responseBody   Json?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([producerId, createdAt])
  @@index([eventId, createdAt])
}

/// Bearer key an EventOS organization uses on /api/partner/v1 (`siapp_pk_<8>_<32>`). One active
/// key per producer; generated by ADMIN staff, shown once, sha256 stored.
model ProducerApiKey {
  id          String    @id @default(cuid())
  producerId  String
  prefix      String
  keyHash     String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  producer  Producer   @relation(fields: [producerId], references: [id], onDelete: Cascade)
  createdBy StaffUser? @relation(fields: [createdById], references: [id])

  @@index([producerId, revokedAt])
}

/// `Idempotency-Key` replay store for mutating partner-API requests (contract §1): the first
/// response is replayed for 24 h; a different body under the same key is a 422.
model PartnerIdempotency {
  id          String   @id @default(cuid())
  producerId  String
  key         String
  requestHash String
  status      Int
  response    Json
  createdAt   DateTime @default(now())

  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@unique([producerId, key])
  @@index([createdAt])
}

model Event {
  id             String      @id @default(cuid())
  producerId     String
  cityId         String
  title          String
  description    String?
  venue          String?
  address        String?
  imageUrls      String[]
  tags           String[]
  startsAt       DateTime
  endsAt         DateTime
  status         EventStatus @default(DRAFT)
  publishedAt    DateTime?
  scannerCode    String      @unique
  scannerPinHash String
  scannerFailedLogins Int    @default(0) // wrong-PIN streak; reset on success (scanner login rate limit)
  scannerLockedUntil  DateTime?
  source          EventSource @default(MANUAL)
  externalId      String? // EventOS event id (source = EVENTOS)
  snapshotVersion Int         @default(0) // monotonic per event; a lower push is refused (409 stale_version)
  pausedAt        DateTime? // partner "pause": hidden from members, no new redemptions, live ones untouched
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  producer    Producer     @relation(fields: [producerId], references: [id])
  city        City         @relation(fields: [cityId], references: [id])
  offers      Offer[]
  redemptions Redemption[]
  settlements Settlement[]
  scans       Scan[]

  @@unique([producerId, externalId])
  @@index([cityId, status, startsAt])
  @@index([producerId])
}

model Offer {
  id                      String                @id @default(cuid())
  eventId                 String
  name                    String
  type                    OfferType
  keyCost                 Int
  faceValueCents          Int? // DISCOUNT_TICKET only
  discountPercent         Int? // DISCOUNT_TICKET only, 0–100
  allocationType          AllocationType
  capacity                Int? // CAPPED only
  validUntil              DateTime? // TIME_WINDOW only, absolute UTC
  afterWindowBehaviour    AfterWindowBehaviour? // TIME_WINDOW only
  privateSaleTiers        TierCode[] // empty = no private sale
  privateSaleHoursBefore  Int? // 24 | 48
  privateSaleOpensAt      DateTime? // computed from publishedAt, editable
  openToFree              Boolean               @default(false)
  plusOneAllowed          Boolean               @default(false)
  plusOneExtraKeyCost     Int                   @default(0)
  plusOneExtraCashCents   Int?
  cancellationWindowHours Int? // null = global setting
  maxPerMember            Int                   @default(1)
  redeemFrom              DateTime?
  redeemUntil             DateTime?
  sortOrder               Int                   @default(0)
  externalRef             String? // EventOS "{eventId}:{ticketTypeId}:{mode}" (source = EVENTOS)
  paymentMode             PaymentMode           @default(SIAPP_COLLECTS)
  keyCostOverride         Int? // staff override of the pricing rule (EventOS offers only)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  redemptions     Redemption[]
  waitlistEntries WaitlistEntry[]

  @@unique([eventId, externalRef])
  @@index([eventId])
}

// ───────────────────────── Redemption, tickets, scans ─────────────────────────

model Redemption {
  id                    String           @id @default(cuid())
  memberId              String
  offerId               String
  eventId               String
  status                RedemptionStatus
  keyCost               Int // total keys debited incl. +1
  plusOneName           String?
  cashCents             Int              @default(0) // discounted ticket (+ plus-one cash)
  stripePaymentIntentId String?          @unique
  stripeCheckoutSessionId String?        @unique // discounted tickets pay through Checkout; webhook completes
  stripeRefundId        String?
  paymentExpiresAt      DateTime? // PENDING_PAYMENT hold expiry
  // Producer-collects (EventOS) discounted tickets: the QR payload is minted at
  // redemption so EventOS can adopt it as its ticket token; the Ticket row is
  // created when EventOS reports `order.paid` (docs/EVENTOS_INTEGRATION.md).
  qrPayload             String?          @unique
  externalOrderId       String? // EventOS order holding/paid for this redemption
  externalPayUrl        String? // signed EventOS checkout link (valid until paymentExpiresAt)
  externalRefundedAt    DateTime? // EventOS confirmed the cash refund
  externalRefundError   String? // EventOS could not refund (staff follow-up)
  cancelDeadlineAt      DateTime // startsAt − cancellation window
  cancelledAt           DateTime?
  checkedInAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  member          Member           @relation(fields: [memberId], references: [id])
  offer           Offer            @relation(fields: [offerId], references: [id])
  event           Event            @relation(fields: [eventId], references: [id])
  ticket          Ticket?
  keyTransactions KeyTransaction[]
  fraudFlags      FraudFlag[]

  @@index([offerId, status])
  @@index([memberId, status])
  @@index([eventId, status])
  @@index([paymentExpiresAt])
}

model Ticket {
  id               String   @id @default(cuid())
  redemptionId     String   @unique
  qrPayload        String   @unique // same format and signing as EventOS
  signature        String
  memberName       String
  photoSnapshotUrl String?
  plusOneName      String?
  externalTicketId String? // EventOS mirror ticket (set when `redemption.activated` is acknowledged)
  externalOrderId  String?
  issuedAt         DateTime @default(now())

  redemption Redemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  scans      Scan[]
}

model Scan {
  id         String     @id @default(cuid())
  ticketId   String?
  eventId    String
  result     ScanResult
  rawPayload String?
  scannedBy  String? // scanner session / staff id — "eventos:{gate}" for the producer's scanner
  source     ScanSource @default(SIAPP)
  externalId String?    @unique // EventOS check-in id (idempotency for reported scans)
  disputed   Boolean    @default(false)
  disputeNote String?
  scannedAt  DateTime   @default(now())

  ticket Ticket? @relation(fields: [ticketId], references: [id])
  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([eventId, scannedAt])
}

model WaitlistEntry {
  id         String         @id @default(cuid())
  offerId    String
  memberId   String
  status     WaitlistStatus @default(WAITING)
  notifiedAt DateTime?
  claimBy    DateTime? // notifiedAt + waitlist_claim_minutes
  createdAt  DateTime       @default(now())

  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id])

  @@unique([offerId, memberId])
  @@index([offerId, status, createdAt])
  @@index([claimBy])
}

// ───────────────────────── Referrals ─────────────────────────

model Referral {
  id         String         @id @default(cuid())
  referrerId String
  inviteeId  String         @unique
  code       String
  status     ReferralStatus @default(PENDING)
  vestedAt   DateTime?
  rejectedReason String?
  createdAt  DateTime       @default(now())

  referrer Member @relation("Referrer", fields: [referrerId], references: [id])
  invitee  Member @relation("Invitee", fields: [inviteeId], references: [id])

  @@index([referrerId, status])
}

// ───────────────────────── Partner communities (ELL bridge) ─────────────────────────

model PartnerCommunity {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. ELL
  name      String
  publicKey String // PEM, verifies RS256 claim tokens
  promo     Json // e.g. { "grantTier": "SOCIAL", "months": 3 } or { "stripeCouponId": "..." }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims PartnerClaim[]
}

model PartnerClaim {
  id               String   @id @default(cuid())
  communityId      String
  memberId         String
  externalMemberId String
  tokenJti         String?  @unique
  claimedAt        DateTime @default(now())

  community PartnerCommunity @relation(fields: [communityId], references: [id])
  member    Member           @relation(fields: [memberId], references: [id])

  @@unique([communityId, externalMemberId])
  @@index([memberId])
}

// ───────────────────────── Fraud ─────────────────────────

model Device {
  id          String   @id @default(cuid())
  memberId    String
  fingerprint String
  userAgent   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, fingerprint])
  @@index([fingerprint])
}

model FraudFlag {
  id           String          @id @default(cuid())
  memberId     String
  redemptionId String?
  rule         FraudRule
  evidence     Json
  status       FraudFlagStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime        @default(now())

  member     Member      @relation(fields: [memberId], references: [id])
  redemption Redemption? @relation(fields: [redemptionId], references: [id])
  reviewedBy StaffUser?  @relation(fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([memberId])
}

// ───────────────────────── Settlements ─────────────────────────

model Settlement {
  id          String           @id @default(cuid())
  producerId  String
  eventId     String           @unique
  status      SettlementStatus @default(OPEN)
  currency    String
  amountCents Int
  paidAt      DateTime?
  reference   String?
  emailedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  producer Producer         @relation(fields: [producerId], references: [id])
  event    Event            @relation(fields: [eventId], references: [id])
  lines    SettlementLine[]

  @@index([producerId, status])
}

model SettlementLine {
  id              String @id @default(cuid())
  settlementId    String
  ticketId        String @unique
  faceValueCents  Int
  discountPercent Int
  owedCents       Int // face × (1 − discount%), round half up

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Settings, staff, Stripe ─────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  role         StaffRole @default(OPS)
  passwordHash String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  keyAdjustments KeyTransaction[]
  fraudReviews   FraudFlag[]
  apiKeysCreated ProducerApiKey[]
  leadsContacted FounderLead[]
}

// Idempotency for Stripe webhooks: store every event id, skip duplicates (src/lib/stripe-webhook.ts).
model StripeEvent {
  id          String    @id // Stripe event id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([type, receivedAt])
}
